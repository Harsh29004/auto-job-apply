NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# Optional: for company jobs that ask you to email your resume
SMTP_EMAIL=
SMTP_APP_PASSWORD=


# ================= JOB ROLES (edit here; these override config.yaml) =================
# Comma-separated. Every keyword is searched separately on Naukri.
JOB_KEYWORDS=ai ml engineer, machine learning engineer, artificial intelligence, data scientist, deep learning engineer, computer vision engineer, nlp engineer, generative ai, python developer, python django flask, web developer, react developer, full stack developer
# Empty = all locations. Example: bangalore, pune, ahmedabad, surat, remote
JOB_LOCATIONS=
# Job title must contain at least one of these words
JOB_TITLE_INCLUDE=ai, ml, machine learning, artificial intelligence, deep learning, data scientist, data science, computer vision, nlp, generative ai, genai, gen ai, llm, python, django, flask, fastapi, web developer, web development, frontend, front end, front-end, react, full stack, fullstack, full-stack, mern, software engineer, software developer, trainee, intern
# Skip job if the title contains any of these words
JOB_TITLE_EXCLUDE=senior, sr, lead, manager, architect, principal, staff, head, director, vp, java, .net, dotnet, php, salesforce, sap, android, ios, sales, marketing, teacher, tutor, faculty, professor, trainer, bpo, voice, annotator, annotation, instructor, mentor, react native, non paid, unpaid, machine shop
# Skip these companies (part of the name is enough)
JOB_COMPANY_EXCLUDE=
# Naukri experience filter (years)
JOB_EXPERIENCE_YEARS=1
# Skip jobs whose minimum required experience is more than this
JOB_MAX_MIN_EXPERIENCE=1
# Only jobs posted in the last N days (1, 3, 7, 15, 30)
JOB_AGE_DAYS=7
# Pages per search (20 jobs per page)
JOB_PAGES_PER_SEARCH=2
# Minimum number of your skills a job must match
JOB_MIN_SCORE=2
# Max Naukri applications per run (Naukri limit ~50/day)
MAX_APPLIES_PER_RUN=25
